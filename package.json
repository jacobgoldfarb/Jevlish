{
  "name": "jevlish",
  "version": "0.3.0",
  "description": "Typed Jev judgments for TypeScript business logic.",
  "author": "Jacob Goldfarb",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jacobgoldfarb/Jevlish.git"
  },
  "homepage": "https://jacobgoldfarb.github.io/Jevlish/",
  "bugs": {
    "url": "https://github.com/jacobgoldfarb/Jevlish/issues"
  },
  "keywords": [
    "jev",
    "typescript",
    "semantic",
    "typesafe"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "import": "./dist/runtime.js",
      "default": "./dist/runtime.js"
    },
    "./testing": {
      "types": "./dist/testkit.d.ts",
      "import": "./dist/testkit.js",
      "default": "./dist/testkit.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js",
      "default": "./dist/types.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run typecheck && npm test && npm run build && npm run exports:check && npm run apps:check",
    "apps:check": "sh scripts/check-apps.sh",
    "exports:check": "node scripts/check-exports.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "example": "node --env-file=.env --import tsx examples/triage.ts",
    "docs": "npm --prefix docs run dev",
    "docs:build": "npm --prefix docs run build"
  },
  "dependencies": {
    "@typesafe-ai/sdk": "^0.6.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
