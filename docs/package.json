    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@astrojs/starlight": "^0.42.2",
    "astro": "^7.3.3",
    "sharp": "^0.35.4",
    "starlight-typedoc": "^0.23.1",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.13.1"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
